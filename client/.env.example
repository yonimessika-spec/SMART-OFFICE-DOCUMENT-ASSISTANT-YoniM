# Copy to client/.env. Front-end config only — no secrets belong in this file.

# Per-endpoint mock switches. Only the exact string "false" selects the real
# call in src/api/client.js (via the Express proxy). Anything else — or unset —
# uses src/api/mock.js. Default: mock everything (SPEC.md §6, build mock-first).
VITE_USE_MOCK_DOCUMENTS=true
VITE_USE_MOCK_PROCESS=true
VITE_USE_MOCK_REVIEW=true

# Base URL of the Express proxy (server/). Used only when a flag above is "false".
VITE_SERVER_BASE_URL=http://localhost:5055

# Client-side upload size ceiling in MB (SPEC.md F1).
VITE_MAX_FILE_MB=10
