# Copy to server/.env (git-ignored). Real values live in .env, never here.
# SPEC.md §5 / F8: N8N_SECRET is attached only inside server/ and must never
# appear in any file under client/.

# Base URL of the n8n instance's webhooks, no trailing slash.
N8N_BASE_URL=https://your-n8n-host.example.com/webhook

# Path of each n8n webhook, appended to N8N_BASE_URL.
# Only N8N_DOCUMENTS_PATH is used so far; the other two are here so this file
# does not need restructuring when /api/process and /api/review are wired.
N8N_DOCUMENTS_PATH=/documents
N8N_PROCESS_PATH=/process-document
N8N_REVIEW_PATH=/review

# Shared secret sent to n8n as the x-api-key header. Server-side only.
N8N_SECRET=replace-with-the-n8n-shared-secret

# How long the proxy waits for an n8n webhook before giving up (milliseconds).
# ~90s covers the slowest document-processing run.
REQUEST_TIMEOUT_MS=90000

# Port this proxy listens on. Must match client/.env VITE_SERVER_BASE_URL.
PORT=5055

# --- Authentication & roles (Section 15) --------------------------------------

# Secret used to sign/verify session JWTs. Use a long random string (>=32 chars),
# e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"`.
# Changing it invalidates every existing session.
JWT_SECRET=replace-with-a-long-random-string

# Postgres connection string (Neon free tier; prefer the POOLED connection string,
# the host with "-pooler" in it). Users live here so they survive Render redeploys
# and spin-downs. Required: if the database is unreachable at boot (after retries)
# the server logs an error and exits; there is no file fallback.
DATABASE_URL=postgresql://user:password@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require

# Initial users, created ONCE, only when the users table is empty. After that they
# are ordinary rows: an Admin can remove them and they stay removed. The passwords
# are bcrypt-hashed on creation and never stored or logged in plaintext. No email
# is sent for seeded users; they are Active immediately.
# Safety net: if the table ever has no Admin, the Admin below is restored.
# Leave a Submitter/Viewer pair blank to skip it (username and password are both
# required for it to take effect).
# The *_EMAIL values must be real addresses (needed for password resets). If one is
# missing a placeholder <username>@seed.invalid is used, the server logs a repeated
# warning, and the Users screen flags it until you edit the address there.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=replace-with-a-strong-password
SEED_ADMIN_EMAIL=admin@example.com
SEED_SUBMITTER_USERNAME=submitter
SEED_SUBMITTER_PASSWORD=replace-with-a-strong-password
SEED_SUBMITTER_EMAIL=submitter@example.com
SEED_VIEWER_USERNAME=viewer
SEED_VIEWER_PASSWORD=replace-with-a-strong-password
SEED_VIEWER_EMAIL=viewer@example.com

# --- Email (invites and password resets) -------------------------------------
# Sent through one n8n webhook ("Doc Assistant - Send Email") that holds the Gmail
# credential. Path appended to N8N_BASE_URL. Leave it commented out in local dev:
# without it (or when NODE_ENV is not production) links are printed to THIS
# server's console instead of emailed.
# N8N_EMAIL_PATH=/send-email

# Optional override: "n8n" always sends through the webhook, "console" never does.
# EMAIL_MODE=console

# Optional. Base URL used in email links. Defaults to CLIENT_ORIGIN. Set it if the
# public app URL differs from the CORS origin.
# APP_BASE_URL=https://your-app.netlify.app

# Optional. How many proxies sit between the browser and this server, for rate
# limiting by client IP. Default: 2 in production (Netlify + Render), 0 otherwise.
# TRUST_PROXY_HOPS=2

# Exact origin of the client (Vite dev server by default). CORS runs with
# credentials, so this cannot be "*". Must match where the browser loads the app.
CLIENT_ORIGIN=http://localhost:5173

# "development" (default) or "production". In production the session cookie is
# marked Secure (HTTPS-only), so set this only when the app is served over HTTPS.
NODE_ENV=development
