# Copy to server/.env (git-ignored). Real values live in .env, never here.
# SPEC.md §5 / F8: N8N_SECRET is attached only inside server/ and must never
# appear in any file under client/.

# Base URL of the n8n instance's webhooks, no trailing slash.
N8N_BASE_URL=https://your-n8n-host.example.com/webhook

# Path of each n8n webhook, appended to N8N_BASE_URL.
# Only N8N_DOCUMENTS_PATH is used so far; the other two are here so this file
# does not need restructuring when /api/process and /api/review are wired.
N8N_DOCUMENTS_PATH=/documents
N8N_PROCESS_PATH=/process-document
N8N_REVIEW_PATH=/review

# Shared secret sent to n8n as the x-api-key header. Server-side only.
N8N_SECRET=replace-with-the-n8n-shared-secret

# How long the proxy waits for an n8n webhook before giving up (milliseconds).
# ~90s covers the slowest document-processing run.
REQUEST_TIMEOUT_MS=90000

# Port this proxy listens on. Must match client/.env VITE_SERVER_BASE_URL.
PORT=5055

# --- Authentication & roles (Section 15) --------------------------------------

# Secret used to sign/verify session JWTs. Use a long random string (>=32 chars),
# e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"`.
# Changing it invalidates every existing session.
JWT_SECRET=replace-with-a-long-random-string

# Initial Admin, created on first boot only (when server/users.json has no users).
# After that user exists, these are ignored — change the password from the app or
# by editing users.json. The seed password is bcrypt-hashed on creation and is
# never stored or logged in plaintext.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=replace-with-a-strong-password

# Exact origin of the client (Vite dev server by default). CORS runs with
# credentials, so this cannot be "*". Must match where the browser loads the app.
CLIENT_ORIGIN=http://localhost:5173

# "development" (default) or "production". In production the session cookie is
# marked Secure (HTTPS-only), so set this only when the app is served over HTTPS.
NODE_ENV=development
