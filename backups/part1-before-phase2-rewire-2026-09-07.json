      "parameters": {
        "text": "=Today's date: {{ $now.toFormat('yyyy-MM-dd') }}\n\nDocument content:\n{{ $json.text }}",
        "attributes": {
          "attributes": [
            {
              "name": "document_type",
              "description": "Choose exactly one: invoice, request, report, complaint, contract, quote, or other.",
              "required": true
            },
            {
              "name": "sender_or_company",
              "description": "Name of the person or organization who sent the document. Use \"Not found\" if absent.",
              "required": true
            },
            {
              "name": "summary",
              "description": "Explain the document in no more than three short sentences.",
              "required": true
            },
            {
              "name": "requested_action",
              "description": "What the company should do next in response to this document. Use \"No action found\" if the document requires no action.",
              "required": true
            },
            {
              "name": "deadline",
              "description": "Any deadline mentioned in the document, returned exactly as written (e.g., \"August 5, 2026\" or \"within 7 days\"). Use \"Not found\" if absent",
              "required": true
            },
            {
              "name": "urgency",
              "description": "Exactly one of: Low, Medium, High.",
              "required": true
            },
            {
              "name": "department",
              "description": "Which department should handle this. Exactly one of: Sales, Finance, Support, HR, Management, General.",
              "required": true
            },
            {
              "name": "deadline_iso",
              "description": "The deadline converted to ISO 8601 date format (YYYY-MM-DD). If the deadline is a specific date like \"August 5, 2026\" convert to \"2026-08-05\". If it's a relative expression like \"within 7 days\" or \"valid for 7 days\", calculate the actual date based on today. Return an empty string if no deadline."
            }
          ]
        },
        "options": {
          "systemPromptTemplate": "You are an office assistant that reads business documents (invoices, customer requests, complaints, supplier quotes, contracts, and internal reports) and extracts structured information for logging.\n\nRules:\n- Extract only information that appears in the document. Never invent missing details.\n- When information is missing, use \"Not found\" (or \"No action found\" for the requested_action field).\n- Mark urgency as High only when the document contains an immediate deadline (within 3 days), payment risk, legal or safety risk, or an explicit urgent request.\n- Mark urgency as Medium when there is a deadline but it is not immediate, or when a response is clearly expected.\n- Mark urgency as Low when the document is informational and no action is required.\n- Return the deadline exactly as written in the document (do not reformat dates)."
        }
      },
